  "_log_doc": [
    "Greps the last 5 CitizenFX logs. Kept deliberately narrow.",
    "'require', 'load(', 'menu', 'esp', 'crash', 'kick' and 'executing' all",
    "occur in normal log output on a healthy install.",
    "'cheat' had to go too: every FiveM client logs",
    "  rage::gameskeleton::runinitfunctions: invoking ccheat init_core",
    "at startup, so keeping it flagged a clean install as CHEATER. The",
    "individual cheat names (eulen, executor, norecoil, ...) and the WinAPI",
    "indicators (loadlibrary, writeprocessmemory, ...) still catch a real menu."
  ],
  "log_scan_words": [
    "loaded script", "startedscript", "loaded module", "dll injected",
    "loadlibrary", "virtualalloc", "writeprocessmemory", "createremotethread",
    "setwindowshook", "openprocess", "lua_load", "assert(load", "dofile(",
    "eulen", "executor", "aimbot",
    "norecoil", "silentaim", "magicbullet", "wallhack", "triggerbot",
    "hwid", "spoofer", "injector", "aceclient.dll", "easyanticheat",
    "battleye", "tamper"
  ],

  "_content_doc": [
    "Keywords looked for INSIDE files, not just in names. A cheat script is",
    "often named innocuously ('client.lua', 'weapon.cfg'), so the name sweep",
    "alone misses it. These rules open small files and search their bytes:",
    "  'norecoil', 'no_recoil', 'no-recoil' and 'No Recoil' are the SAME word",
    "  (any amount of space/._- between the parts is tolerated).",
    "",
    "Severity is earned by the word itself:",
    "  high   -> grew the verdict to CHEATER (aimbot, norecoil, wallhack, ...)",
    "  medium -> SUSPICIOUS (autoclicker, bunnyhop, antirecoil, ...)",
    "  low    -> info only, never changes the verdict (recoil, macro, ...).",
    "",
    "exts limits which file types a rule is scanned in: '*' means every small",
    "file including .dll/.exe; otherwise only the listed extensions. Bare",
    "English words (recoil, macro) are restricted to script/config files so",
    "a game's own settings or a Help folder note can not push a clean PC to",
    "SUSPICIOUS. Scan cost is bounded: text files up to 512 KB, binaries up",
    "to 1 MB. Only the matched keyword is reported - never the file contents."
  ],
  "content_rules": [
    {
      "severity": "high",
      "words": [
        "norecoil", "no_recoil", "no-recoil", "norecoilhack", "recoilhack",
        "recoilmacro", "recoilscript", "aimbot", "silentaim",
        "silentaimshootatwall", "magicbullet", "triggerbot", "triggerbotscript",
        "wallhack", "nospread", "noshootingrecoil", "luaexecutor",
        "extremeinjector", "xenosinjector", "kdmapper", "hwidspoofer",
        "manualmapper", "cheatengine"
      ]
    },
    {
      "severity": "medium",
      "words": ["antirecoil", "anti_recoil", "recoilcontrol", "spreadcontrol",
                "autoclicker", "auto_click", "auto_clicker", "bunnyhop",
                "bunny_hop"],
      "exts": ["lua", "ahk", "ah2", "ahkl", "cfg", "ini", "txt", "ps1"]
    },
    {
      "severity": "low",
      "words": ["recoil", "macro", "aimassist"],
      "exts": ["lua", "ahk", "ah2", "ahkl", "cfg", "ini", "txt", "ps1"]
    }
  ]
}
